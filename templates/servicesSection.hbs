<section id="services">
    {{> sectionHeader title="Услуги"}}

    <div class="wrapper">
        <div class="services-grid">
            {{#each services}}
                <div class="service">
                    <div class="container has-transition">
                        <div class="service-head">
                            <div class="number">{{number}}</div>
                            <div class="title">{{title}}</div>
                        </div>
                        <div class="service-body">
                            <p>{{description}}</p>
                        </div>
                        <!-- Кнопка для открытия модалки -->
                        <button type="button" class="btn-modal" data-modal-id="modal-{{@index}}">
                            Подробнее
                        </button>
                    </div>
                </div>

                <!-- Модальное окно для каждой услуги -->
                <div class="modal" id="modal-{{@index}}" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title">{{title}}</h5>
                                <button type="button" class="close-modal" data-modal-id="modal-{{@index}}">&times;</button>
                            </div>

                            <div class="modal-body">
                                <div class="modal-img">
                                    {{> pictureBlock
                                            path="/imgs/services/"
                                            base=img.base
                                            avif1="1"
                                            avif2="2"
                                            sizes="300px"
                                            params=""
                                            alt=img.alt
                                    }}
                                </div>
                                {{detailed}}
                            </div>

                        </div>
                    </div>
                </div>

            {{/each}}
        </div>
    </div>
</section>